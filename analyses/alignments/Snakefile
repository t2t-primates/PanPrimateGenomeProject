"""
Progressive Cactus / HAL whole-genome alignment pipeline.

Builds a multi-species HAL alignment (and derived pairwise MAFs) from the
primary (`pri`) assembly of every released genome listed in
manifests/sample_data_manifest.csv, following the naming/versioning
convention documented in comparative/README.md.

Run with real data:
    snakemake --configfile config/config.yaml --cores 32 --use-singularity

Run against the example/template data shipped in this repo (no real
assemblies exist yet, so this is a dry-run smoke test of the pipeline
structure, not a real alignment):
    snakemake -n --configfile config/config.yaml
"""

import csv

configfile: "config/config.yaml"

MANIFEST = config["manifest_path"]


def released_genomes():
    """Return {accession_id: {"genome_id": ..., "genome_pri": ...}} for every
    currently-latest, released genome in the manifest."""
    genomes = {}
    with open(MANIFEST) as f:
        for row in csv.DictReader(f):
            if row["assembly_status"] == "released" and row["is_latest"] == "TRUE":
                genomes[row["accession_id"]] = {
                    "genome_id": row["genome_id"],
                    "genome_pri": row["genome_pri"],
                }
    return genomes


GENOMES = released_genomes()
BUILD_ID = config["build_id"]  # e.g. "build1" - matches comparative/comparative_manifest.csv


rule all:
    input:
        f"results/{BUILD_ID}/all_species_{BUILD_ID}.hal",
        expand(
            f"results/{BUILD_ID}/maf/{{accession_id}}_vs_human.maf",
            accession_id=GENOMES.keys(),
        ),
        f"results/{BUILD_ID}/comparative_manifest_row.csv",


rule fetch_assembly:
    """Pull one genome's primary assembly from S3 (no local copy kept
    long-term; Cactus reads directly from the staged FASTA)."""
    output:
        fa=temp("staged/{accession_id}.pri.fa.gz"),
    params:
        s3_path=lambda wc: GENOMES[wc.accession_id]["genome_pri"],
        bucket=config["bucket"],
    shell:
        """
        aws s3 cp --no-sign-request \
          s3://{params.bucket}/{params.s3_path} {output.fa}
        """


rule build_seqfile:
    """Generate the Cactus seqFile (species tree + genome paths) required
    as input to Progressive Cactus."""
    input:
        genomes=expand("staged/{accession_id}.pri.fa.gz", accession_id=GENOMES.keys()),
        tree=config["species_tree_newick"],
    output:
        seqfile=f"results/{BUILD_ID}/seqfile.txt",
    run:
        with open(input.tree) as t, open(output.seqfile, "w") as out:
            out.write(t.read().strip() + "\n")
            for accession_id in GENOMES:
                out.write(f"{accession_id} staged/{accession_id}.pri.fa.gz\n")


rule cactus_align:
    """Run Progressive Cactus to produce the multi-species HAL alignment."""
    input:
        seqfile=f"results/{BUILD_ID}/seqfile.txt",
    output:
        hal=f"results/{BUILD_ID}/all_species_{BUILD_ID}.hal",
    container:
        config["cactus_container"]
    threads: config["cactus_threads"]
    shell:
        """
        cactus jobstore_{BUILD_ID} {input.seqfile} {output.hal} \
          --binariesMode local --maxCores {threads}
        """


rule hal_to_maf_pairwise:
    """Extract a pairwise MAF (species vs. human) from the HAL alignment,
    matching the naming convention in comparative/README.md."""
    input:
        hal=f"results/{BUILD_ID}/all_species_{BUILD_ID}.hal",
    output:
        maf=f"results/{BUILD_ID}/maf/{{accession_id}}_vs_human.maf",
    container:
        config["cactus_container"]
    shell:
        """
        hal2maf {input.hal} {output.maf} \
          --refGenome human --targetGenomes {wildcards.accession_id}
        """


rule record_comparative_manifest_row:
    """Emit a row matching comparative/comparative_manifest.csv's schema,
    to be appended after review (not auto-committed by the pipeline)."""
    input:
        hal=f"results/{BUILD_ID}/all_species_{BUILD_ID}.hal",
    output:
        row=f"results/{BUILD_ID}/comparative_manifest_row.csv",
    params:
        included=":".join(g["genome_id"] for g in GENOMES.values()),
        hal_path=f"comparative/hal/all_species_{BUILD_ID}.hal",
    shell:
        """
        echo "build_id,hal_path,included_genome_ids,release_date,notes" > {output.row}
        echo "{BUILD_ID},{params.hal_path},{params.included},$(date +%F),Generated by analyses/alignments/Snakefile" >> {output.row}
        """
